# ============================================================
# OryxOS .gitignore
# 目标：仓库里只留源码与文档，运行期产物、依赖、密钥一律不进库
# ============================================================

# ---------- Maven / Java ----------
target/
*.class
*.jar
!/.mvn/wrapper/maven-wrapper.jar
*.log
hs_err_pid*
replay_pid*

# ---------- Node / 前端构建 ----------
node_modules/
dist/
.vite/
.vitepress/cache/
.vitepress/dist/
*.tsbuildinfo

# ---------- IDE / 操作系统 ----------
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# ---------- AI 助手本地数据（保留本地，不公开） ----------
.codebuddy/

# ---------- 运行期工作区（由 oryxos init 生成） ----------
# 里面是本地 Agent、记忆、会话库、日志，推送上去等于公开自己的运行数据
.oryxos/
logs/
*.db
*.db-journal
*.db-wal
*.db-shm
*.dumpstream
*.lst

# ---------- 本地配置与密钥 ----------
# 示例文件 config/application.yml.example 要提交，真实配置绝不提交
config/application.yml
config/*.local.yml
.env
.env.*

# ---------- 临时/调试产物 ----------
boot-*.log
*.tmp
nul'
test.txt
